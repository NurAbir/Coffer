<UserControl x:Class="Coffer.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Coffer.Views"
             Background="{StaticResource InkBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══════════ Sidebar ═══════════ -->
        <Border Grid.Column="0"
                Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid Margin="16,22,14,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="4,0,0,0">
                    <ContentControl Width="36" Height="36" Style="{StaticResource BrandMark}"/>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Coffer"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Text="offline vault"
                                   FontSize="10"
                                   Foreground="{StaticResource FaintBrush}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,34,0,0">
                    <TextBlock Text="WORKSPACE"
                               FontSize="9"
                               FontWeight="Bold"
                               Foreground="{StaticResource FaintBrush}"
                               Margin="12,0,0,8"/>

                    <ListBox Style="{StaticResource NavListBox}"
                             ItemContainerStyle="{StaticResource NavItemStyle}"
                             SelectedIndex="{Binding SelectedPageIndex}">
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72E;" Style="{StaticResource IconText}" FontSize="14" Margin="0,0,10,0"/>
                                <TextBlock Text="Vault" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE945;" Style="{StaticResource IconText}" FontSize="14" Margin="0,0,10,0"/>
                                <TextBlock Text="Generator" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE713;" Style="{StaticResource IconText}" FontSize="14" Margin="0,0,10,0"/>
                                <TextBlock Text="Settings" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>
                </StackPanel>

                <StackPanel Grid.Row="3">
                    <Border Background="{StaticResource FieldBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="12,11">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72E;" Style="{StaticResource IconText}" FontSize="12" Foreground="{StaticResource SuccessBrush}"/>
                                <TextBlock Text="Vault encrypted"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="AES-256-GCM + Argon2id"
                                       Style="{StaticResource CaptionText}"
                                       Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <Button Command="{Binding LockCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Margin="0,10,0,0"
                            HorizontalContentAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72E;" Style="{StaticResource IconText}" FontSize="12" Margin="0,0,8,0"/>
                            <TextBlock Text="Lock vault" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════ Main area ═══════════ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="28,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="{Binding PageTitle}" Style="{StaticResource PageTitleText}"/>
                        <TextBlock Text="{Binding PageSubtitle}" Style="{StaticResource MutedText}" Margin="0,3,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{StaticResource FieldBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="7"
                                Padding="10,7"
                                Margin="0,0,10,0">
                            <TextBlock Text="On this device only"
                                       FontSize="10"
                                       Foreground="{StaticResource FaintBrush}"/>
                        </Border>

                        <Button Command="{Binding AddEntryCommand}"
                                Style="{StaticResource PrimaryButton}"
                                Padding="14,9"
                                Visibility="{Binding IsVaultPage, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" Style="{StaticResource IconText}" FontSize="12" Margin="0,0,7,0"/>
                                <TextBlock Text="New entry" FontSize="12" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Pages -->
            <TabControl Grid.Row="1"
                        Style="{StaticResource HiddenTabs}"
                        SelectedIndex="{Binding SelectedPageIndex}">

                <!-- Vault -->
                <TabItem>
                    <Grid Margin="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="332"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Entry list -->
                        <Border Grid.Column="0"
                                Style="{StaticResource Card}"
                                Margin="0,0,16,0"
                                Padding="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid>
                                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                             Padding="36,9,12,9"
                                             FontSize="12"/>
                                    <TextBlock Text="&#xE721;"
                                               Style="{StaticResource IconText}"
                                               FontSize="13"
                                               Foreground="{StaticResource FaintBrush}"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Center"
                                               Margin="12,0,0,0"
                                               IsHitTestVisible="False"/>
                                    <TextBlock Text="Search entries"
                                               FontSize="12"
                                               Foreground="{StaticResource FaintBrush}"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Center"
                                               Margin="36,0,0,0"
                                               IsHitTestVisible="False"
                                               Visibility="{Binding IsSearchEmpty, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </Grid>

                                <Grid Grid.Row="1" Margin="4,12,4,8">
                                    <TextBlock Text="{Binding EntryCountText}" Style="{StaticResource CaptionText}"/>
                                    <TextBlock Text="Saved automatically"
                                               Style="{StaticResource CaptionText}"
                                               HorizontalAlignment="Right"/>
                                </Grid>

                                <Grid Grid.Row="2">
                                    <ListBox Style="{StaticResource EntryListBox}"
                                             ItemContainerStyle="{StaticResource EntryItemStyle}"
                                             ItemsSource="{Binding EntriesView}"
                                             SelectedItem="{Binding SelectedEntry}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Border Width="36" Height="36"
                                                            CornerRadius="9"
                                                            Background="{StaticResource AccentSoftBrush}"
                                                            VerticalAlignment="Top">
                                                        <TextBlock Text="{Binding ServiceInitial}"
                                                                   FontSize="14"
                                                                   FontWeight="Bold"
                                                                   Foreground="{StaticResource AccentBrush}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                    </Border>

                                                    <StackPanel Grid.Column="1" Margin="11,0,0,0">
                                                        <TextBlock Text="{Binding Service}"
                                                                   FontSize="13"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextBrush}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Username}"
                                                                   Style="{StaticResource CaptionText}"
                                                                   Margin="0,2,0,0"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding TagsDisplay}"
                                                                   FontSize="10"
                                                                   Foreground="{StaticResource AccentBrush}"
                                                                   Opacity="0.75"
                                                                   Margin="0,3,0,0"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <!-- Empty state -->
                                    <Grid Visibility="{Binding IsListEmpty, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                                    Visibility="{Binding IsSearchEmpty, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Border Width="46" Height="46"
                                                    CornerRadius="23"
                                                    Background="{StaticResource FieldBrush}"
                                                    HorizontalAlignment="Center">
                                                <TextBlock Text="&#xE72E;"
                                                           Style="{StaticResource IconText}"
                                                           FontSize="18"
                                                           Foreground="{StaticResource FaintBrush}"/>
                                            </Border>
                                            <TextBlock Text="Your vault is empty"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextBrush}"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,14,0,4"/>
                                            <TextBlock Text="Add an entry to get started."
                                                       Style="{StaticResource CaptionText}"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>

                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                                    Visibility="{Binding IsSearchEmpty, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                            <TextBlock Text="No matches"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextBrush}"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Text="Try a different search."
                                                       Style="{StaticResource CaptionText}"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Editor -->
                        <Border Grid.Column="1" Style="{StaticResource Card}">
                            <Grid>
                                <views:EntryEditorView DataContext="{Binding SelectedEntry}"/>

                                <Border Background="{StaticResource SurfaceBrush}"
                                        CornerRadius="14"
                                        Visibility="{Binding SelectedEntry, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Inverse}">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="320">
                                        <Border Width="58" Height="58"
                                                CornerRadius="29"
                                                Background="{StaticResource FieldBrush}"
                                                HorizontalAlignment="Center">
                                            <TextBlock Text="&#xE72E;"
                                                       Style="{StaticResource IconText}"
                                                       FontSize="22"
                                                       Foreground="{StaticResource FaintBrush}"/>
                                        </Border>
                                        <TextBlock Text="Select an entry"
                                                   FontSize="18"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextBrush}"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,18,0,6"/>
                                        <TextBlock Text="Choose something from the list, or create a new entry. Everything saves automatically."
                                                   Style="{StaticResource MutedText}"
                                                   TextAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- Generator -->
                <TabItem>
                    <views:GeneratorView Margin="24"/>
                </TabItem>

                <!-- Settings -->
                <TabItem>
                    <views:SettingsView Margin="24"/>
                </TabItem>
            </TabControl>

            <!-- Status bar -->
            <Border Grid.Row="2"
                    Background="{StaticResource SidebarBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="26,8">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="6" Height="6" CornerRadius="3">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource SuccessBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                        <TextBlock Text="{Binding StatusMessage}"
                                   Style="{StaticResource StatusText}"
                                   FontSize="11"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="{Binding AutoLockSummary}"
                               Style="{StaticResource CaptionText}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══════════ Overlay: delete entry ═══════════ -->
        <Grid Grid.ColumnSpan="2"
              Background="#CC05080D"
              Visibility="{Binding ShowDeleteEntryConfirm, Converter={StaticResource BoolToVisibilityConverter}}"
              Panel.ZIndex="200">
            <Border Width="430"
                    Style="{StaticResource Card}"
                    Padding="30"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Delete entry?"
                               FontSize="21"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="{Binding PendingDeleteEntryName, StringFormat='“{0}” will be removed from your vault.'}"
                               Style="{StaticResource MutedText}"
                               Margin="0,8,0,6"/>
                    <TextBlock Text="This cannot be undone."
                               FontSize="11"
                               Foreground="{StaticResource DangerBrush}"
                               Margin="0,0,0,22"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel"
                                Command="{Binding CancelDeleteEntryCommand}"
                                Style="{StaticResource SecondaryButton}"
                                Margin="0,0,10,0"/>
                        <Button Content="Delete entry"
                                Command="{Binding ConfirmDeleteEntryCommand}"
                                Style="{StaticResource DangerButton}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══════════ Overlay: delete vault ═══════════ -->
        <Grid Grid.ColumnSpan="2"
              Background="#E605080D"
              Visibility="{Binding ShowDeleteVaultConfirm, Converter={StaticResource BoolToVisibilityConverter}}"
              Panel.ZIndex="210">
            <Border Width="480"
                    Style="{StaticResource Card}"
                    Padding="34"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <Border Width="52" Height="52"
                            CornerRadius="26"
                            Background="{StaticResource DangerSoftBrush}"
                            HorizontalAlignment="Left">
                        <TextBlock Text="&#xE74D;"
                                   Style="{StaticResource IconText}"
                                   FontSize="20"
                                   Foreground="{StaticResource DangerBrush}"/>
                    </Border>

                    <TextBlock Text="Delete this vault?"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"
                               Margin="0,16,0,8"/>
                    <TextBlock Text="Every password, username, note, and recovery setting will be permanently removed from this computer. There is no back door and no way to undo it."
                               Style="{StaticResource MutedText}"
                               LineHeight="20"/>

                    <Border Background="{StaticResource DangerSoftBrush}"
                            BorderBrush="#4A2A2E"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,10"
                            Margin="0,18,0,0">
                        <TextBlock Text="Make an encrypted backup first if there is any chance you will need this vault."
                                   FontSize="11"
                                   Foreground="{StaticResource WarningBrush}"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <CheckBox Content="I understand this cannot be undone."
                              IsChecked="{Binding DeleteVaultConfirmed}"
                              Margin="2,18,0,0"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                        <Button Content="Cancel"
                                Command="{Binding CancelDeleteVaultCommand}"
                                Style="{StaticResource SecondaryButton}"
                                Margin="0,0,10,0"/>
                        <Button Content="Delete vault forever"
                                Command="{Binding ConfirmDeleteVaultCommand}"
                                Style="{StaticResource DangerButton}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>