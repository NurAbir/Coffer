<UserControl x:Class="Coffer.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource InkBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.08*"/>
            <ColumnDefinition Width="0.92*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══════════ Brand / story side ═══════════ -->
        <Grid Grid.Column="0" ClipToBounds="True">
            <Ellipse Width="620" Height="620"
                     Fill="{StaticResource HeroGlowBrush}"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Top"
                     Margin="-220,-250,0,0"/>
            <Ellipse Width="440" Height="440"
                     Fill="{StaticResource HeroGlowBrush}"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Bottom"
                     Margin="0,0,-240,-220"
                     Opacity="0.55"/>

            <StackPanel Margin="64,56,40,48" VerticalAlignment="Center" MaxWidth="500" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <ContentControl Width="44" Height="44" Style="{StaticResource BrandMark}"/>
                    <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="COFFER"
                                   FontSize="21"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Text="OFFLINE PASSWORD VAULT"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBrush}"
                                   Margin="1,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock Text="A quiet place for&#x0a;your passwords."
                           FontSize="42"
                           FontWeight="SemiBold"
                           LineHeight="50"
                           Foreground="{StaticResource TextBrush}"
                           Margin="0,54,0,0"/>

                <TextBlock Text="An encrypted vault that lives on your device. No accounts, no cloud, no telemetry — just your secrets, locked behind one master password."
                           Style="{StaticResource MutedText}"
                           FontSize="14"
                           LineHeight="23"
                           MaxWidth="430"
                           HorizontalAlignment="Left"
                           Margin="0,18,0,0"/>

                <StackPanel Margin="0,38,0,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <Border Width="24" Height="24" CornerRadius="12" Background="{StaticResource AccentSoftBrush}" VerticalAlignment="Center">
                            <TextBlock Text="&#xE73E;" Style="{StaticResource IconText}" FontSize="11" Foreground="{StaticResource AccentBrush}"/>
                        </Border>
                        <TextBlock Text="AES-256-GCM encryption for every vault and every password"
                                   Style="{StaticResource MutedText}"
                                   VerticalAlignment="Center"
                                   Margin="11,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <Border Width="24" Height="24" CornerRadius="12" Background="{StaticResource AccentSoftBrush}" VerticalAlignment="Center">
                            <TextBlock Text="&#xE73E;" Style="{StaticResource IconText}" FontSize="11" Foreground="{StaticResource AccentBrush}"/>
                        </Border>
                        <TextBlock Text="Argon2id key derivation makes guessing expensive"
                                   Style="{StaticResource MutedText}"
                                   VerticalAlignment="Center"
                                   Margin="11,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="24" Height="24" CornerRadius="12" Background="{StaticResource AccentSoftBrush}" VerticalAlignment="Center">
                            <TextBlock Text="&#xE73E;" Style="{StaticResource IconText}" FontSize="11" Foreground="{StaticResource AccentBrush}"/>
                        </Border>
                        <TextBlock Text="A 12-word recovery phrase, shown only once"
                                   Style="{StaticResource MutedText}"
                                   VerticalAlignment="Center"
                                   Margin="11,0,0,0"/>
                    </StackPanel>
                </StackPanel>

                <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,44,0,18" MaxWidth="430" HorizontalAlignment="Left"/>
                <TextBlock Text="Coffer 1.1.0  ·  Windows 10/11  ·  Fully offline"
                           Style="{StaticResource CaptionText}"/>
            </StackPanel>
        </Grid>

        <!-- ═══════════ Form side ═══════════ -->
        <Grid Grid.Column="1" Background="#0D121B">
            <Border Width="404"
                    Style="{StaticResource Card}"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Padding="34,32">
                <StackPanel>
                    <TextBlock Text="SECURE VAULT"
                               FontSize="9"
                               FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}"
                               Margin="0,0,0,10"/>

                    <TextBlock Text="{Binding FormTitle}"
                               FontSize="25"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="{Binding FormSubtitle}"
                               Style="{StaticResource MutedText}"
                               Margin="0,7,0,22"/>

                    <Border Background="{StaticResource FieldBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,9"
                            Margin="0,0,0,18">
                        <TextBlock Text="{Binding StatusMessage}"
                                   Style="{StaticResource StatusText}"/>
                    </Border>

                    <!-- Password / create mode -->
                    <StackPanel Visibility="{Binding IsRecoveryMode, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <TextBlock Text="Master password" Style="{StaticResource FieldLabel}"/>
                        <PasswordBox x:Name="PasswordBox"
                                     FontSize="14"
                                     PasswordChanged="PasswordBox_PasswordChanged"
                                     PreviewKeyDown="PasswordBox_KeyDown"
                                     PreviewKeyUp="PasswordBox_KeyUp"/>

                        <TextBlock x:Name="CapsLockHint"
                                   Text="Caps Lock is on"
                                   FontSize="10"
                                   Foreground="{StaticResource WarningBrush}"
                                   Margin="2,5,0,0"
                                   Visibility="Collapsed"/>

                        <StackPanel Visibility="{Binding IsCreatingVault, Converter={StaticResource BoolToVisibilityConverter}}"
                                    Margin="0,15,0,0">
                            <TextBlock Text="Confirm master password" Style="{StaticResource FieldLabel}"/>
                            <PasswordBox x:Name="ConfirmPasswordBox"
                                         FontSize="14"
                                         PasswordChanged="ConfirmPasswordBox_PasswordChanged"
                                         PreviewKeyDown="PasswordBox_KeyDown"
                                         PreviewKeyUp="PasswordBox_KeyUp"/>
                            <TextBlock Text="At least 8 characters. A long passphrase is ideal."
                                       Style="{StaticResource CaptionText}"
                                       Margin="2,6,0,0"/>
                        </StackPanel>

                        <Button Content="Unlock vault"
                                Command="{Binding UnlockCommand}"
                                Style="{StaticResource PrimaryButton}"
                                IsDefault="True"
                                Margin="0,22,0,0"
                                Visibility="{Binding IsCreatingVault, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>

                        <Button Content="Create vault"
                                Command="{Binding CreateVaultCommand}"
                                Style="{StaticResource PrimaryButton}"
                                IsDefault="True"
                                Margin="0,22,0,0"
                                Visibility="{Binding IsCreatingVault, Converter={StaticResource BoolToVisibilityConverter}}"/>

                        <TextBlock Text="Working…"
                                   FontSize="11"
                                   Foreground="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,10,0,0"
                                   Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"/>

                        <Button Content="Forgot your password? Use your recovery phrase"
                                Command="{Binding ToggleRecoveryModeCommand}"
                                Style="{StaticResource LinkButton}"
                                FontSize="11"
                                Margin="0,16,0,0"
                                HorizontalAlignment="Center"
                                Visibility="{Binding IsCreatingVault, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                    </StackPanel>

                    <!-- Recovery mode -->
                    <StackPanel Visibility="{Binding IsRecoveryMode, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="Recovery phrase" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding RecoveryPhrase, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 Height="86"
                                 VerticalScrollBarVisibility="Auto"
                                 FontSize="13"/>
                        <TextBlock Text="All 12 words, in order, separated by spaces."
                                   Style="{StaticResource CaptionText}"
                                   Margin="2,6,0,16"/>

                        <Button Content="Recover vault"
                                Command="{Binding RecoveryLoginCommand}"
                                Style="{StaticResource PrimaryButton}"/>

                        <Button Content="Back to password"
                                Command="{Binding BackToLoginCommand}"
                                Style="{StaticResource LinkButton}"
                                FontSize="11"
                                Margin="0,16,0,0"
                                HorizontalAlignment="Center"/>
                    </StackPanel>

                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,24,0,14"/>
                    <TextBlock Text="AES-256-GCM  ·  Argon2id  ·  no network access"
                               Style="{StaticResource CaptionText}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <TextBlock Text="Your vault never leaves this computer."
                       Style="{StaticResource CaptionText}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Bottom"
                       Margin="0,0,0,22"/>
        </Grid>

        <!-- ═══════════ Overlay: recovery phrase ═══════════ -->
        <Border Grid.ColumnSpan="2"
                Background="#D905080D"
                Visibility="{Binding ShowRecoveryPhrase, Converter={StaticResource BoolToVisibilityConverter}}"
                Panel.ZIndex="100">
            <Grid>
                <Border Width="590"
                        Style="{StaticResource Card}"
                        Padding="38,32"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <ContentControl Width="38" Height="38" Style="{StaticResource BrandMark}"/>
                            <TextBlock Text="Save your recovery phrase"
                                       FontSize="22"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}"
                                       VerticalAlignment="Center"
                                       Margin="13,0,0,0"/>
                        </StackPanel>

                        <TextBlock Text="This is the only way back in if you forget your master password. It is shown once and never stored in readable form."
                                   Style="{StaticResource MutedText}"
                                   TextAlignment="Center"
                                   Margin="0,14,0,20"/>

                        <Border Background="{StaticResource FieldBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="12">
                            <ItemsControl ItemsSource="{Binding RecoveryWords}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="3"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource SurfaceAltBrush}"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Margin="4"
                                                Padding="10,8">
                                            <TextBlock Text="{Binding}"
                                                       FontFamily="Consolas"
                                                       FontSize="13"
                                                       Foreground="{StaticResource AccentBrush}"
                                                       HorizontalAlignment="Center"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <CheckBox Content="I have written down all 12 words in order."
                                  IsChecked="{Binding HasConfirmedPhrase}"
                                  Margin="2,18,0,0"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                            <Button Content="{Binding CopyPhraseButtonText}"
                                    Command="{Binding CopyRecoveryPhraseCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    Margin="0,0,10,0"/>
                            <Button Content="Continue"
                                    Command="{Binding ContinueAfterRecoveryCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    MinWidth="120"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ═══════════ Overlay: new password after recovery ═══════════ -->
        <Border Grid.ColumnSpan="2"
                Background="#D905080D"
                Visibility="{Binding IsPostRecoveryChangePassword, Converter={StaticResource BoolToVisibilityConverter}}"
                Panel.ZIndex="90">
            <Grid>
                <Border Width="450"
                        Style="{StaticResource Card}"
                        Padding="36,32"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="Set a new master password"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Text="Your recovery phrase worked. Choose a new master password and Coffer will generate a fresh recovery phrase."
                                   Style="{StaticResource MutedText}"
                                   Margin="0,8,0,22"/>

                        <Border Background="{StaticResource FieldBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12,9"
                                Margin="0,0,0,18">
                            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource StatusText}"/>
                        </Border>

                        <TextBlock Text="New master password" Style="{StaticResource FieldLabel}"/>
                        <PasswordBox x:Name="NewPasswordBox"
                                     FontSize="14"
                                     PasswordChanged="NewPasswordBox_PasswordChanged"
                                     PreviewKeyDown="PasswordBox_KeyDown"
                                     PreviewKeyUp="PasswordBox_KeyUp"/>

                        <TextBlock Text="Confirm new password" Style="{StaticResource FieldLabel}" Margin="0,15,0,6"/>
                        <PasswordBox x:Name="ConfirmNewPasswordBox"
                                     FontSize="14"
                                     PasswordChanged="ConfirmNewPasswordBox_PasswordChanged"
                                     PreviewKeyDown="PasswordBox_KeyDown"
                                     PreviewKeyUp="PasswordBox_KeyUp"/>

                        <Button Content="Set password and generate phrase"
                                Command="{Binding SetNewPasswordAfterRecoveryCommand}"
                                Style="{StaticResource PrimaryButton}"
                                Margin="0,22,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ═══════════ Overlay: lockout ═══════════ -->
        <Border Grid.ColumnSpan="2"
                Background="#E605080D"
                Visibility="{Binding IsLockedOut, Converter={StaticResource BoolToVisibilityConverter}}"
                Panel.ZIndex="80">
            <Grid>
                <Border Width="440"
                        Style="{StaticResource Card}"
                        Padding="40,38"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <StackPanel>
                        <Border Width="58" Height="58"
                                CornerRadius="29"
                                Background="{StaticResource DangerSoftBrush}"
                                HorizontalAlignment="Center">
                            <TextBlock Text="&#xE72E;"
                                       Style="{StaticResource IconText}"
                                       FontSize="24"
                                       Foreground="{StaticResource DangerBrush}"/>
                        </Border>

                        <TextBlock Text="Vault locked"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,16,0,8"/>
                        <TextBlock Text="Too many incorrect password attempts."
                                   Style="{StaticResource MutedText}"
                                   TextAlignment="Center"/>

                        <Border Background="{StaticResource FieldBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="9"
                                Padding="18,14"
                                Margin="0,20,0,14">
                            <TextBlock Text="{Binding LockoutMessage}"
                                       FontFamily="Consolas"
                                       FontSize="16"
                                       Foreground="{StaticResource WarningBrush}"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"/>
                        </Border>

                        <TextBlock Text="Coffer unlocks automatically when the countdown ends. Your recovery phrase still works."
                                   Style="{StaticResource CaptionText}"
                                   TextAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>