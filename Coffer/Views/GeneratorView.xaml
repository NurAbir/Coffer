<UserControl x:Class="Coffer.Views.GeneratorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="820" HorizontalAlignment="Stretch">

            <Border Style="{StaticResource Card}" Padding="26,24">
                <StackPanel>
                    <TextBlock Text="Create a password" Style="{StaticResource SectionTitleText}"/>
                    <TextBlock Text="Everything is generated on this device with the Windows cryptographic random number generator."
                               Style="{StaticResource MutedText}"
                               Margin="0,4,0,20"/>

                    <!-- Mode -->
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource SegmentRadio}"
                                     Content="Random password"
                                     IsChecked="{Binding IsPassphraseMode, Converter={StaticResource InverseBoolConverter}}"/>
                        <RadioButton Style="{StaticResource SegmentRadio}"
                                     Content="Passphrase"
                                     Margin="6,0,0,0"
                                     IsChecked="{Binding IsPassphraseMode}"/>
                    </StackPanel>

                    <!-- Random options -->
                    <StackPanel Margin="0,22,0,0"
                                Visibility="{Binding IsPassphraseMode, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Length" Style="{StaticResource FieldLabel}" Margin="0" VerticalAlignment="Center"/>
                            <Slider Grid.Column="1"
                                    Minimum="8"
                                    Maximum="128"
                                    Margin="16,0"
                                    IsSnapToTickEnabled="True"
                                    TickFrequency="1"
                                    Value="{Binding Length}"/>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding Length}"
                                       Width="34"
                                       TextAlignment="Right"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <UniformGrid Columns="2" Margin="0,18,0,0">
                            <CheckBox Content="Uppercase (A - Z)" IsChecked="{Binding UseUppercase}" Margin="0,0,0,12"/>
                            <CheckBox Content="Lowercase (a - z)" IsChecked="{Binding UseLowercase}" Margin="0,0,0,12"/>
                            <CheckBox Content="Digits (0 - 9)" IsChecked="{Binding UseDigits}" Margin="0,0,0,12"/>
                            <CheckBox Content="Symbols (!@#...)" IsChecked="{Binding UseSymbols}" Margin="0,0,0,12"/>
                        </UniformGrid>

                        <CheckBox Content="Exclude look-alike characters (0 O 1 l I)"
                                  IsChecked="{Binding ExcludeAmbiguous}"
                                  Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Passphrase options -->
                    <StackPanel Margin="0,22,0,0"
                                Visibility="{Binding IsPassphraseMode, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Word count" Style="{StaticResource FieldLabel}" Margin="0" VerticalAlignment="Center"/>
                            <Slider Grid.Column="1"
                                    Minimum="3"
                                    Maximum="12"
                                    Margin="16,0"
                                    IsSnapToTickEnabled="True"
                                    TickFrequency="1"
                                    Value="{Binding WordCount}"/>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding WordCount}"
                                       Width="34"
                                       TextAlignment="Right"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="Words are drawn from a large list and joined with hyphens, which makes them easier to type and remember."
                                   Style="{StaticResource CaptionText}"
                                   Margin="0,12,0,0"/>
                    </StackPanel>

                    <!-- Output -->
                    <Border Background="{StaticResource FieldBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="16,14"
                            Margin="0,22,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding GeneratedPassword}"
                                       FontFamily="Consolas"
                                       FontSize="17"
                                       Foreground="{StaticResource AccentBrush}"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0"/>
                            <Button Grid.Column="1"
                                    Style="{StaticResource SecondaryButton}"
                                    Content="{Binding CopyButtonText}"
                                    Command="{Binding CopyCommand}"
                                    VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Strength -->
                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Entropy"
                                   Style="{StaticResource MutedText}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Entropy, StringFormat='{}{0:F1} bits'}"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontWeight="SemiBold"
                                   Margin="8,0,16,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2"
                                   Text="{Binding StrengthText}"
                                   FontWeight="Bold"
                                   Foreground="{Binding StrengthText, Converter={StaticResource StrengthToColorConverter}}"
                                   VerticalAlignment="Center"/>
                    </Grid>
                    <ProgressBar Value="{Binding StrengthPercent, Mode=OneWay}"
                                 Maximum="100"
                                 Margin="0,10,0,0"
                                 Foreground="{Binding StrengthText, Converter={StaticResource StrengthToColorConverter}}"/>

                    <!-- Actions -->
                    <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                        <Button Content="Generate new"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding GenerateCommand}"/>
                    </StackPanel>

                    <TextBlock Text="{Binding StatusMessage}"
                               Style="{StaticResource MutedText}"
                               Margin="0,14,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="22,18" Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock Text="Clipboard safety" Style="{StaticResource SectionTitleText}"/>
                    <TextBlock Text="Copied passwords are cleared from the clipboard automatically after 30 seconds, and only if nothing else has replaced them."
                               Style="{StaticResource MutedText}"
                               Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
