<Window x:Class="Coffer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Coffer.Views"
        Title="Coffer"
        Height="800" Width="1240"
        MinHeight="680" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource InkBrush}"
        Icon="Assets/logo.ico">
    <Grid>
        <views:LoginView x:Name="LoginViewControl" Visibility="Visible"/>
        <views:DashboardView x:Name="DashboardViewControl" Visibility="Collapsed"/>
    </Grid>
</Window>